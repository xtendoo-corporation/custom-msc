<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Definición del reporte para Órdenes de Trabajo FSM -->
        <record id="action_report_fsm_order" model="ir.actions.report">
            <field name="name">Orden de Trabajo FSM</field>
            <field name="model">msc.fsm.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">msc_fsm.report_fsm_order</field>
            <field name="report_file">msc_fsm.report_fsm_order</field>
            <field name="print_report_name">'Orden de Trabajo - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_msc_fsm_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Template principal del reporte -->
        <template id="report_fsm_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="msc_fsm.report_fsm_order_document" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- Documento de la orden de trabajo -->
        <template id="report_fsm_order_document">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <div class="page">
                    <div class="oe_structure"/>

                    <!-- Cabecera -->
                    <div class="row align-items-end mb-4 border-bottom pb-2">
                        <div class="col-6">
                            <h3 class="m-0">
                                <span t-if="not doc.is_closed">Orden de Trabajo</span>
                                <span t-if="doc.is_closed">Orden de Trabajo Finalizada</span>
                                <span t-field="doc.name"/>
                            </h3>
                        </div>
                        <div class="col-6 text-end" style="font-size: 0.9em;">
                            <span class="mr-3" t-if="doc.date_scheduled"><strong>Programada:</strong> <span t-field="doc.date_scheduled" t-options="{'widget': 'date'}"/></span>
                            <t t-else="">
                                <span class="mr-3"><strong>Creada:</strong> <span t-field="doc.date_created" t-options="{'widget': 'date'}"/></span>
                            </t>
                            <span class="mr-3"><strong>Estado:</strong> <span t-field="doc.stage_id"/></span>
                            <span><strong>Prioridad:</strong> 
                                <t t-if="doc.priority_level == '0'">Muy Baja</t>
                                <t t-if="doc.priority_level == '1'">Baja</t>
                                <t t-if="doc.priority_level == '2'">Normal</t>
                                <t t-if="doc.priority_level == '3'">Alta</t>
                                <t t-if="doc.priority_level == '4'">Muy Alta</t>
                                <t t-if="doc.priority_level == '5'">Urgente</t>
                            </span>
                        </div>
                    </div>

                    <!-- Información del cliente y Descripción -->
                    <div class="row mt32 mb32">
                        <div class="col-6">
                            <div class="mb-3">
                                <strong>Cliente:</strong>
                                <div t-field="doc.partner_id"
                                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            </div>
                            <div class="mb-3" t-if="doc.contact_id">
                                <strong>Contacto:</strong>
                                <div t-field="doc.contact_id"
                                    t-options='{"widget": "contact", "fields": ["name", "phone", "email"], "no_marker": True, "phone_icons": True}'/>
                            </div>
                            <div class="mb-3" t-if="doc.location_id">
                                <strong>Ubicación del Servicio:</strong>
                                <div>
                                    <span t-field="doc.location_id.name"/><br/>
                                    <span t-field="doc.location_id.street" t-if="doc.location_id.street"/>
                                    <span t-field="doc.location_id.street2" t-if="doc.location_id.street2"/><br/>
                                    <span t-field="doc.location_id.zip" t-if="doc.location_id.zip"/>
                                    <span t-field="doc.location_id.city" t-if="doc.location_id.city"/>
                                    <span t-field="doc.location_id.country_id" t-if="doc.location_id.country_id"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <strong style="font-size: 1.1em; border-bottom: 1px solid #eee; display: inline-block; padding-bottom: 2px; margin-bottom: 8px;">Descripción del Trabajo</strong>
                            <p t-field="doc.description" style="white-space: pre-wrap; word-break: break-word;"/>
                        </div>
                    </div>

                    <!-- Información del equipo y técnicos -->
                    <div class="row mt16 mb16">
                        <div class="col-6" t-if="doc.person_ids">
                            <h5>Equipo de Trabajo</h5>
                            <div t-if="doc.person_ids">
                                <strong>Técnicos Asignados:</strong>
                                <t t-foreach="doc.person_ids" t-as="person">
                                    <span t-field="person.name"/>
                                    <t t-if="not person_last">, </t>
                                </t>
                            </div>
                        </div>
                        <div class="col-6" t-if="doc.tag_ids">
                            <h5>Etiquetas</h5>
                            <div t-if="doc.tag_ids">
                                <strong>Etiquetas:</strong>
                                <t t-foreach="doc.tag_ids" t-as="tag">
                                    <span t-field="tag.name"/>
                                    <t t-if="not tag_last">, </t>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Fechas de ejecución -->
                    <div class="row mt16 mb16" t-if="doc.date_start or doc.date_end">
                        <div class="col-12">
                            <div style="background-color: #f8f9fa; padding: 10px; border-radius: 4px;">
                                <strong class="mr-3">Información de Ejecución:</strong>
                                <span class="mr-4" t-if="doc.date_start"><strong>Inicio:</strong> <span t-field="doc.date_start"/></span>
                                <span class="mr-4" t-if="doc.date_end"><strong>Fin:</strong> <span t-field="doc.date_end"/></span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Materiales Consumidos -->
                    <div t-if="doc.material_line_ids" class="mt-4">
                        <strong style="font-size: 1.1em; border-bottom: 1px solid #eee; display: inline-block; padding-bottom: 2px; margin-bottom: 8px;">Materiales Consumidos</strong>
                        <table class="table table-sm o_main_table mt-2">
                            <thead style="display: table-row-group;">
                                <tr>
                                    <th>Producto</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.material_line_ids" t-as="line">
                                    <td><span t-field="line.product_id.name"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.uom_id.name" groups="uom.group_uom"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Horas Empleadas -->
                    <div t-if="doc.timesheet_line_ids" class="mt-4">
                        <strong style="font-size: 1.1em; border-bottom: 1px solid #eee; display: inline-block; padding-bottom: 2px; margin-bottom: 8px;">Horas Empleadas</strong>
                        <table class="table table-sm o_main_table mt-2">
                            <thead style="display: table-row-group;">
                                <tr>
                                    <th>Técnico</th>
                                    <th>Fecha</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Duración (Horas)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.timesheet_line_ids" t-as="line">
                                    <td><span t-field="line.employee_id.name"/></td>
                                    <td><span t-field="line.date"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.duration" t-options="{'widget': 'float_time'}"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Notas -->
                    <div class="row mt16 mb16" t-if="doc.internal_note or doc.customer_note">
                        <div class="col-6" t-if="doc.customer_note">
                            <h5>Notas del Cliente</h5>
                            <p t-field="doc.customer_note"/>
                        </div>
                        <div class="col-6" t-if="doc.internal_note">
                            <h5>Notas Internas</h5>
                            <p t-field="doc.internal_note"/>
                        </div>
                    </div>

                    <!-- Firma -->
                    <div class="row mt64" t-if="doc.is_closed">
                        <div class="col-6">
                            <h5>Firma del Cliente</h5>
                            <div style="height: 80px; border: 1px solid #ccc; margin-top: 10px;"></div>
                            <p class="text-center mt8">
                                <strong>Nombre y Firma</strong><br/>
                                Fecha: _______________
                            </p>
                        </div>
                        <div class="col-6">
                            <h5>Firma del Técnico</h5>
                            <div style="height: 80px; border: 1px solid #ccc; margin-top: 10px;"></div>
                            <p class="text-center mt8">
                                <strong>Técnico / Técnicos</strong><br/>
                                Fecha: _______________
                            </p>
                        </div>
                    </div>

                    <div class="oe_structure"/>
                </div>
            </t>
        </template>

    </data>
</odoo>
