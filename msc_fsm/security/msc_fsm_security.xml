<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Grupos de seguridad -->
        <record id="group_fsm_user" model="res.groups">
            <field name="name">MSC FSM Usuario</field>
        </record>

        <record id="group_fsm_manager" model="res.groups">
            <field name="name">MSC FSM Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_fsm_user'))]" />
        </record>

        <!-- Reglas de registro -->
        <record id="fsm_order_rule_user" model="ir.rule">
            <field name="name">FSM Order: Usuario puede ver sus órdenes</field>
            <field name="model_id" ref="model_msc_fsm_order" />
            <field name="domain_force">[('person_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="fsm_order_rule_manager" model="ir.rule">
            <field name="name">FSM Order: Manager puede ver todas</field>
            <field name="model_id" ref="model_msc_fsm_order" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>
        <!-- Regla multi-compañía: cada usuario solo ve órdenes de su compañía -->
        <record id="fsm_order_multi_company_rule" model="ir.rule">
            <field name="name">FSM Order: Multi-compañía</field>
            <field name="model_id" ref="model_msc_fsm_order" />
            <field name="global" eval="True" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <!-- Reglas para que el FSM Usuario vea pedidos desde su orden -->
        <record id="fsm_sale_order_rule_user" model="ir.rule">
            <field name="name">Sale Order: FSM Usuario puede ver pedidos vinculados</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field name="domain_force">[('fsm_order_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="fsm_sale_order_line_rule_user" model="ir.rule">
            <field name="name">Sale Order Line: FSM Usuario puede ver lineas vinculadas</field>
            <field name="model_id" ref="sale.model_sale_order_line" />
            <field name="domain_force">[('order_id.fsm_order_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

    </data>
</odoo>
