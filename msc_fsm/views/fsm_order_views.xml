<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de árbol para órdenes FSM -->
        <record id="view_msc_fsm_order_tree" model="ir.ui.view">
            <field name="name">msc.fsm.order.tree</field>
            <field name="model">msc.fsm.order</field>
            <field name="arch" type="xml">
                <list string="Órdenes de Trabajo">
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="location_id" />
                    <field name="stage_id" />
                    <field name="priority_level" widget="priority" />
                    <field name="date_scheduled" />
                    <field name="company_id" groups="base.group_multi_company" />
                </list>
            </field>
        </record>

        <!-- Vista de formulario para órdenes FSM -->
        <record id="view_msc_fsm_order_form" model="ir.ui.view">
            <field name="name">msc.fsm.order.form</field>
            <field name="model">msc.fsm.order</field>
            <field name="arch" type="xml">
                <form string="Orden de Trabajo">
                    <header>
                        <button name="action_start_work" string="Iniciar Trabajo"
                            type="object" class="btn-primary"
                            invisible="date_start or is_closed" />
                        <button name="action_finish_work" string="Finalizar Trabajo"
                            type="object" class="btn-primary"
                            invisible="not date_start or date_end or is_closed" />
                        <button name="action_create_sale_order" string="Crear Orden de Venta"
                            type="object" class="btn-secondary"
                            invisible="sale_count &gt; 0"
                            groups="msc_fsm.group_fsm_manager" />

                        <button name="action_print_order" string="Imprimir"
                            type="object" class="btn-secondary" />
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_sale_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="sale_count == 0">
                                <field name="sale_count" widget="statinfo" string="Órdenes de Venta" />
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>

                        <group>
                            <group name="customer_info" string="Información del Cliente">
                                <!-- Manager: editable -->
                                <field name="partner_id" required="1"
                                    groups="msc_fsm.group_fsm_manager" />
                                <field name="contact_id" domain="[('parent_id', '=', partner_id)]"
                                    groups="msc_fsm.group_fsm_manager" />
                                <field name="location_id" domain="[('parent_id', '=', partner_id)]"
                                    groups="msc_fsm.group_fsm_manager" />
                                <!-- Usuario: solo lectura -->
                                <field name="partner_id" readonly="1"
                                    groups="!msc_fsm.group_fsm_manager" />
                                <field name="contact_id" readonly="1"
                                    groups="!msc_fsm.group_fsm_manager" />
                                <field name="location_id" readonly="1"
                                    groups="!msc_fsm.group_fsm_manager" />
                            </group>
                            <group name="service_info" string="Información del Trabajo">
                                <!-- Manager: editable -->
                                <field name="person_ids" widget="many2many_tags"
                                    groups="msc_fsm.group_fsm_manager" />
                                <field name="priority_level" widget="priority"
                                    groups="msc_fsm.group_fsm_manager" />
                                <field name="tag_ids" widget="many2many_tags"
                                    groups="msc_fsm.group_fsm_manager" />
                                <!-- Usuario: solo lectura -->
                                <field name="person_ids" widget="many2many_tags" readonly="1"
                                    groups="!msc_fsm.group_fsm_manager" />
                                <field name="priority_level" widget="priority" readonly="1"
                                    groups="!msc_fsm.group_fsm_manager" />
                                <field name="tag_ids" widget="many2many_tags" readonly="1"
                                    groups="!msc_fsm.group_fsm_manager" />
                            </group>
                        </group>

                        <group>
                            <group name="basic_info" string="Información Básica">
                                <field name="description"
                                    placeholder="Describe el trabajo a realizar..." />
                            </group>
                            <group name="scheduling" string="Programación">
                                <field name="date_scheduled" />
                                <field name="date_start" />
                                <field name="date_end" />
                                <field name="duration" widget="float_time" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Materiales" name="materials">
                                <field name="material_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id" />
                                        <field name="name" />
                                        <field name="quantity" />
                                        <field name="uom_id" />
                                    </list>
                                </field>
                            </page>
                            <page string="Partes de Horas" name="timesheets">
                                <field name="timesheet_line_ids">
                                    <list editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="date" />
                                        <field name="name" />
                                        <field name="duration" widget="float_time" />
                                    </list>
                                </field>
                            </page>
                            <page string="Notas">
                                <group>
                                    <field name="internal_note" string="Notas Internas" />
                                    <field name="customer_note" string="Notas del Cliente" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_post="True" />
                </form>
            </field>
        </record>

        <!-- Vista kanban para órdenes FSM -->
        <record id="view_msc_fsm_order_kanban" model="ir.ui.view">
            <field name="name">msc.fsm.order.kanban</field>
            <field name="model">msc.fsm.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column">
                    <field name="stage_id" />
                    <field name="color" />
                    <field name="priority_level" />
                    <field name="partner_id" />
                    <field name="date_scheduled" />
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click"
                                t-att-style="record.color.raw_value and 'border-left: 4px solid %s' % record.color.raw_value or ''">
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button"
                                        data-bs-toggle="dropdown" href="#"
                                        aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v" />
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <t t-if="widget.editable">
                                            <a role="menuitem" type="edit" class="dropdown-item">
                                                Editar</a>
                                        </t>
                                        <t t-if="widget.deletable">
                                            <a role="menuitem" type="delete" class="dropdown-item">
                                                Eliminar</a>
                                        </t>
                                    </div>
                                </div>
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name" />
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="partner_id" />
                                            <t t-if="record.date_scheduled.raw_value">
                                                <br />
                                                <i class="fa fa-calendar" title="Fecha programada" />
                                                <field name="date_scheduled" />
                                            </t>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority_level" widget="priority" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista calendario para órdenes FSM -->
        <record id="view_msc_fsm_order_calendar" model="ir.ui.view">
            <field name="name">msc.fsm.order.calendar</field>
            <field name="model">msc.fsm.order</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Órdenes"
                    date_start="date_scheduled"
                    color="stage_id">
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="stage_id" />
                </calendar>
            </field>
        </record>

    </data>
</odoo>
