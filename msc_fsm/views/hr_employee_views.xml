<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_msc_fsm" model="ir.ui.view">
        <field name="name">hr.employee.form.msc.fsm</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="FSM MSC" name="msc_fsm">
                    <field name="msc_fsm_service_product_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
